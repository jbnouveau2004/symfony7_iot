{% extends 'base_admin.html.twig' %}

{% block body %}

<div class="container mt-4">
<h3>Ajouter un utilisateur</h3>

    {{ form_start(form, {'attr': {'id': 'new_edit_utilisateur'}}) }}
        <div class="row">
            <div class="col-md-12">{{form_row(form.username, {'label': 'Nom d\'utilisateur'})}}</div>
        </div>
        <div class="row">
            <div class="col-md-12">{{form_row(form.password, {'label': 'Mot de passe', 'id': 'utilisateur_password'})}}</div>
        </div>
        <div class="row">
            <div class="col-md-12">
                <label for="verifpass">Retapez le mot de passe</label>
                <input type="password" id="verifpass" required>
            </div>
        </div>
        {{ form_widget(form) }}
            <button class="btn btn-primary">Ajouter</button>
    {{ form_end(form) }}

</div>

{% endblock %}